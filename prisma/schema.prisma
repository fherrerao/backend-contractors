generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  APPROVER
  CONTRACTOR_USER
}

enum ContractorStatus {
  INCOMPLETE
  COMPLIANT
  EXPIRED
}

enum DocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum ReviewAction {
  APPROVED
  REJECTED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean     @default(true)
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  uploads      Document[]  @relation("UploadedBy")
  reviews      DocumentReview[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([contractorId])
}

model Contractor {
  id          String           @id @default(uuid())
  name        String
  taxId       String           @unique
  email       String?
  phone       String?
  address     String?
  contactName String?
  status      ContractorStatus @default(INCOMPLETE)
  isActive    Boolean          @default(true)
  users       User[]
  projects    Project[]
  workers     Worker[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
}

model Project {
  id           String           @id @default(uuid())
  name         String
  description  String?
  code         String?
  status       ContractorStatus @default(INCOMPLETE)
  isActive     Boolean          @default(true)
  contractorId String
  contractor   Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  documents    Document[]
  workers      ProjectWorker[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([contractorId])
  @@index([status])
}

model Worker {
  id           String          @id @default(uuid())
  name         String
  documentId   String
  position     String
  phone        String?
  email        String?
  isActive     Boolean         @default(true)
  contractorId String
  contractor   Contractor      @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  projects     ProjectWorker[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([contractorId, documentId])
  @@index([contractorId])
}

model ProjectWorker {
  id        String                  @id @default(uuid())
  projectId String
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId  String
  worker    Worker                  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedAt DateTime               @default(now())
  documents ProjectWorkerDocument[]

  @@unique([projectId, workerId])
  @@index([workerId])
}

model ProjectWorkerDocument {
  id              String        @id @default(uuid())
  projectWorkerId String
  projectWorker   ProjectWorker @relation(fields: [projectWorkerId], references: [id], onDelete: Cascade)
  documentId      String
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([projectWorkerId, documentId])
  @@index([documentId])
}

model Document {
  id           String                   @id @default(uuid())
  projectId    String
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  required     Boolean                  @default(true)
  expires      Boolean                  @default(false)
  status       DocumentStatus           @default(PENDING)
  filePath     String?
  fileName     String?
  mimeType     String?
  size         Int?
  expiresAt    DateTime?
  submittedAt  DateTime?
  uploadedById String?
  uploadedBy   User?                    @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviews      DocumentReview[]
  workerLinks  ProjectWorkerDocument[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([projectId, name])
  @@index([status])
}

model DocumentReview {
  id         String       @id @default(uuid())
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User         @relation(fields: [reviewerId], references: [id])
  action     ReviewAction
  comment    String?
  fileName   String?
  createdAt  DateTime     @default(now())

  @@index([documentId])
}
