generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  APPROVER
  CONTRACTOR_USER
}

enum ContractorStatus {
  INCOMPLETE
  COMPLIANT
  EXPIRED
}

enum DocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum ReviewAction {
  APPROVED
  REJECTED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean     @default(true)
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  uploads      Document[]  @relation("UploadedBy")
  reviews      DocumentReview[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([contractorId])
}

model Contractor {
  id          String           @id @default(uuid())
  name        String
  taxId       String           @unique
  email       String?
  phone       String?
  address     String?
  contactName String?
  status      ContractorStatus @default(INCOMPLETE)
  isActive    Boolean          @default(true)
  users        User[]
  projects     Project[]
  workers      Worker[]
  requirements Requirement[]
  createdAt    DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
}

model Project {
  id           String           @id @default(uuid())
  name         String
  description  String?
  code         String?
  status       ContractorStatus @default(INCOMPLETE)
  isActive     Boolean          @default(true)
  contractorId String
  contractor   Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  workers          ProjectWorker[]
  projectDocuments ProjectDocument[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([contractorId])
  @@index([status])
}

model Worker {
  id           String          @id @default(uuid())
  name         String
  documentId   String
  position     String
  phone        String?
  email        String?
  isActive     Boolean          @default(true)
  status       ContractorStatus @default(INCOMPLETE)
  contractorId String
  contractor   Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  projects     ProjectWorker[]
  documents    Document[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([contractorId, documentId])
  @@index([contractorId])
  @@index([status])
}

model Requirement {
  id               String            @id @default(uuid())
  name             String
  isActive         Boolean           @default(true)
  contractorId     String
  contractor       Contractor        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  documents        Document[]
  projectDocuments ProjectDocument[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([contractorId, name])
  @@index([contractorId])
}

model ProjectDocument {
  id            String      @id @default(uuid())
  description   String?
  required      Boolean     @default(true)
  expires       Boolean     @default(false)
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([projectId, requirementId])
  @@index([projectId])
  @@index([requirementId])
}

model ProjectWorker {
  id        String                  @id @default(uuid())
  projectId String
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId  String
  worker    Worker                  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([projectId, workerId])
  @@index([workerId])
}

model Document {
  id            String         @id @default(uuid())
  workerId      String
  worker        Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  status        DocumentStatus @default(PENDING)
  filePath      String?
  fileName      String?
  mimeType      String?
  size          Int?
  expiresAt     DateTime?
  submittedAt   DateTime?
  uploadedById  String?
  uploadedBy    User?          @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviews       DocumentReview[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workerId, requirementId])
  @@index([workerId])
  @@index([requirementId])
  @@index([status])
}

model DocumentReview {
  id         String       @id @default(uuid())
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User         @relation(fields: [reviewerId], references: [id])
  action     ReviewAction
  comment    String?
  fileName   String?
  createdAt  DateTime     @default(now())

  @@index([documentId])
}
